# ---------------------------------------------------------------------
# AgroMind backend configuration (copy to .env and fill in real values)
# ---------------------------------------------------------------------

# --- Database ---
# Defaults to SQLite: backend/agromind.db. Set to a PostgreSQL URL to use Postgres.
# DATABASE_URL=postgresql://user:pass@localhost:5432/agromind
SQLITE_PATH=backend/agromind.db

# --- Auth / JWT ---
# Secret used to sign JWT tokens. CHANGE THIS IN PRODUCTION.
AGROMIND_SECRET_KEY=agromind-dev-secret-change-in-production-32chars+
# Token lifetime in minutes (default 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM provider (Ask AgroMind) ---
# Configure exactly ONE of the options below. When none is set, AgroMind
# uses its grounded deterministic engine (RAG + 1200-crop dataset fallback).

# Option A: OpenAI-compatible (set LLM_BASE_URL for OpenAI or a proxy)
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Option B: Groq
# GROQ_API_KEY=gsk_...

# Option C: OpenRouter
# OPENROUTER_API_KEY=sk-or-...

# Option D: local server (Ollama, vLLM, LM Studio)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Shared LLM settings
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=60

# --- MQTT bridge (IoT sensors) ---
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
BACKEND_URL=http://localhost:8002

# --- Frontend (frontend/.env) ---
# VITE_API_URL=http://localhost:8002