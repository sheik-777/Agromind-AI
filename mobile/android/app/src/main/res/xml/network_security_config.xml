<?xml version="1.0" encoding="utf-8"?>
<!-- Farm LAN backends typically run plain HTTP. Prefer HTTPS in production
     and restrict this config to known hosts at that point. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
